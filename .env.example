VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Guest app URL ────────────────────────────────────────────────────────────
# Base URL of the guest app, used when generating QR codes for tables.
# Required in production (e.g. https://menu.yourapp.com).
# In local dev only, falls back to https://<hostname>:4175 if unset.
# No trailing slash.
VITE_GUEST_APP_URL=
