# ── Guest app URL ────────────────────────────────────────────────────────────
# Base URL of the guest app, used when generating QR codes for tables.
# Defaults to the deployed guest Worker URL if unset. Override per environment.
# In local dev, falls back to https://<hostname>:4175 if unset.
# No trailing slash.
VITE_GUEST_APP_URL=
